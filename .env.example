# Shared secret used by the Python API.
MONTAGNE_API_TOKEN=change-me

# Persistent monitor settings.
MONTAGNE_DATABASE_PATH=./data/monitor.db
MONTAGNE_API_HOST=127.0.0.1
MONTAGNE_API_PORT=8791
MONTAGNE_CATALOG_INTERVAL_SECONDS=30
MONTAGNE_DETAIL_INTERVAL_SECONDS=60

# Next.js server-side proxy settings.
MONTAGNE_BACKEND_URL=http://127.0.0.1:8791
MONTAGNE_BACKEND_TOKEN=change-me
